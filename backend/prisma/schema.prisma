generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  // Viewzo team member with access to the back-office endpoints.
  STAFF
}

// What a team member may do in the back-office (see "Rôles et permissions").
enum StaffRole {
  SUPER_ADMIN // all settings, team management
  COUNTRY_MANAGER // everything in their countries, but never pays out alone
  MODERATOR // accounts, campaigns, posts and views
  FINANCE // withdrawals and payments, never the counted views
  SUPPORT // reads files, no decision
}

enum ProfileType {
  CREATOR
  ADVERTISER
  PROVIDER
}

model User {
  id              String             @id @default(uuid())
  // Used to greet the person; asked at sign-up or taken from the verified ID.
  firstName       String?
  // At least one of phone and email is set and verified.
  phone           String?            @unique
  email           String?            @unique
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  // scrypt hash; null for accounts created by the old code-only login.
  passwordHash    String?
  // Bumped on password change so older tokens stop working.
  tokenVersion    Int                @default(0)
  failedLogins    Int                @default(0)
  lockedUntil     DateTime?
  // ISO 3166-1 alpha-2 country derived from the phone number.
  country         String
  // Signup position within the country, timestamped and never changed afterwards.
  priorityRank    Int
  locale          String             @default("fr")
  role            UserRole           @default(USER)
  // Set for team members (role STAFF).
  staffRole       StaffRole?
  // Countries a team member works on; empty means every country.
  staffCountries  String[]           @default([])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  profiles        UserProfile[]
  accounts        SocialAccount[]
  skills          CreatorSkills?
  campaigns       Campaign[]
  assignments     TaskAssignment[]
  transactions    Transaction[]
  payments        Payment[]
  notifications   Notification[]
  connections     SocialConnection[]
  sessions        Session[]
  identityChecks  IdentityCheck[]
  campaignFiles   CampaignFile[]
  liveProducts    LiveProduct[]
  liveSales       LiveSale[]

  @@unique([country, priorityRank])
}

// A signed-in device. The refresh token is stored hashed and replaced on
// every use; a reused (stolen) token ends the whole family.
model Session {
  id                String    @id @default(uuid())
  userId            String
  // sha256 of the current refresh token.
  tokenHash         String    @unique
  // The token it replaced, accepted without alarm for a few seconds: two
  // browser tabs may refresh at the same moment with the same cookie.
  previousTokenHash String?
  rotatedAt         DateTime?
  expiresAt         DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime  @default(now())
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Append-only journal of every financial, moderation and team action: who,
// what, when, before, after. The database refuses updates and deletes.
model AuditLog {
  id        String   @id @default(uuid())
  // Null for actions taken by the system (webhooks, jobs).
  actorId   String?
  actorRole String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model UserProfile {
  id        String      @id @default(uuid())
  userId    String
  type      ProfileType
  // Verification level 1-3 as defined in the specification.
  level     Int         @default(1)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// Countries Viewzo works in, set by super admins in the back-office. Country
// pickers on the web and in the app only offer the enabled ones.
enum IdentityCheckStatus {
  STARTED // the person is on the provider's pages
  IN_REVIEW // waiting for the team
  APPROVED // level 2 given
  DECLINED // may try again
  ABANDONED // expired or left before the end
}

// One identity verification (ID document, selfie, liveness) of a person.
// Approval raises the creator and advertiser profiles to level 2. Only what
// the team needs is kept: no images, and the document number as a hash.
model IdentityCheck {
  id                  String              @id @default(uuid())
  userId              String
  // didit, or local on a developer machine.
  provider            String
  sessionId           String?             @unique
  url                 String?
  status              IdentityCheckStatus @default(STARTED)
  // The provider's own status, e.g. Approved, In Review, Declined.
  providerStatus      String?
  fullName            String?
  dateOfBirth         String?
  documentType        String?
  documentCountry     String?
  documentNumberLast4 String?
  // HMAC of the document number: finds one document used by two accounts.
  documentNumberHash  String?
  livenessScore       Float?
  faceMatchScore      Float?
  // Why the check was declined or sent to the team.
  reason              String?
  reviewerId          String?
  reviewedAt          DateTime?
  checkedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([documentNumberHash])
}

model AllowedCountry {
  // ISO 3166-1 alpha-2.
  code      String   @id
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CountryCounter {
  country  String @id
  lastRank Int    @default(0)
}

model OtpChallenge {
  id         String    @id @default(uuid())
  // E.164 phone number or lower-case email address.
  target     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, createdAt])
}

enum SocialNetwork {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  SNAPCHAT
  X
  LINKEDIN
  THREADS
  TELEGRAM
  WHATSAPP_STATUS
}

// Statuses shown in "Mes comptes".
enum AccountStatus {
  PENDING // En vérification
  ELIGIBLE // Éligible
  NEEDS_FIX // À corriger
  NOT_ELIGIBLE // Non éligible, new attempt after retryAfter
  SUSPENDED // Suspendu (fraude ou plainte)
}

// Who gave the follower count the team relies on.
enum FollowersSource {
  CREATOR // declared by the creator, confirmed by the team
  ADMIN // entered by the team
  SYSTEM // read from the platform
}

// Why the system refused an account on its own, before anyone reviewed it.
enum AutoRejection {
  NOT_FOUND // Compte introuvable
  ANONYMOUS // Compte anonyme
}

// A creator's account on one network, verified before tasks are offered on it.
model SocialAccount {
  id                      String           @id @default(uuid())
  userId                  String
  network                 SocialNetwork
  // Handle or profile link; for WhatsApp Statut the phone number used.
  handle                  String
  // The handle without @, link or case, so one account is only claimed once.
  handleKey               String
  // Unique code placed in the bio, or sent by WhatsApp to the verification number.
  verificationCode        String           @unique
  status                  AccountStatus    @default(PENDING)
  // What the creator must fix, or why the account is not eligible or suspended.
  statusReason            String?
  retryAfter              DateTime?
  // Last time the account was (re)sent to verification; review is due within 48 h.
  submittedAt             DateTime         @default(now())
  followers               Int?
  // WhatsApp Statut only: average viewers per status.
  avgStatusViews          Int?
  // What the creator said when adding the account (viewers per status for
  // WhatsApp Statut); the team confirms it into followers or avgStatusViews.
  declaredFollowers       Int?
  followersSource         FollowersSource?
  // The creator confirmed the account is theirs and not anonymous.
  notAnonymousConfirmedAt DateTime?
  autoRejection           AutoRejection?
  // Last time the platform was asked about the account.
  autoCheckedAt           DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews                 AccountReview[]

  @@unique([userId, network])
  @@unique([network, handleKey])
}

// Every verification decision and its reason, kept for audit even after the
// creator removes the account.
model AccountReview {
  id         String         @id @default(uuid())
  accountId  String?
  userId     String
  network    SocialNetwork
  // Null when the decision was made automatically.
  reviewerId String?
  status     AccountStatus
  reason     String?
  createdAt  DateTime       @default(now())
  account    SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
}

enum CreatorTaskType {
  POST_PROVIDED_VISUAL
  POST_PROVIDED_VIDEO
  CREATE_ORIGINAL_VIDEO
}

enum CreatorSpecialty {
  FACECAM
  VLOG
  PRODUCT_DEMO
  UNBOXING
  TUTORIAL
  DANCE_CHALLENGE
  HUMOR_SKETCH
  STREET_INTERVIEW
  FULL_EDITING
  MOTION_DESIGN
  VOICE_OVER
  PRODUCT_PHOTO
}

// Answers to the creator skills form.
model CreatorSkills {
  userId          String             @id
  taskTypes       CreatorTaskType[]
  specialties     CreatorSpecialty[]
  showsFace       Boolean
  phoneModel      String?
  microphone      String?
  lighting        String?
  editingSoftware String?
  // 3 to 5 links to videos made by the creator.
  exampleLinks    String[]
  languages       String[]
  // Countries (ISO codes) and cities where the creator can shoot.
  countries       String[]
  cities          String[]
  themes          String[]
  tasksPerWeek    Int
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CampaignObjective {
  AWARENESS
  SALES
  DOWNLOADS
  TRAFFIC
}

// Fixes how many platforms a campaign may use: Basique 1, Pro 3, Premium 6, Élite all.
enum CampaignPackage {
  BASIC
  PRO
  PREMIUM
  ELITE
}

// Without provided assets: videos made by the creators, or designed by the Studio.
enum NoAssetsChoice {
  CREATOR_VIDEOS
  STUDIO
}

enum ContentType {
  PROVIDED_ASSETS // Publication des éléments fournis
  VIDEO_WITH_POSTERS // Vidéo avec les affiches fournies
  FACECAM
  VLOG_DEMO_UNBOXING
  FULL_EDITING
  MOTION_DESIGN
  FREE_BRIEF // Libre selon brief
}

enum CampaignStatus {
  DRAFT // Saved by the advertiser, not sent yet
  PENDING_PAYMENT // Sent, waiting for the budget to go into escrow
  PENDING_REVIEW // Paid, waiting for the team
  ACTIVE
  PAUSED // Stopped by the advertiser: no new creator can take a task
  REJECTED
  COMPLETED
}

// What the advertiser brings for the content.
enum ContentCase {
  READY // Contenu prêt : visuels ou vidéos à publier tels quels
  PARTIAL // Matière partielle : logo, photos, rushes que le créateur assemble
  NONE // Rien : les créateurs ou le Studio créent tout
}

enum CampaignFileKind {
  IMAGE
  VIDEO
  AUDIO
  PDF
}

enum CampaignFilePurpose {
  ASSET // Element given to the creators
  BRIEF // Voice or video brief
}

// A file sent by an advertiser for a campaign, kept by FileStorage and only
// reachable through signed links. Not attached yet while the campaign form is
// being filled; files left unattached are removed after a day.
model CampaignFile {
  id         String              @id @default(uuid())
  ownerId    String
  campaignId String?
  purpose    CampaignFilePurpose
  kind       CampaignFileKind
  name       String
  key        String              @unique
  mimeType   String
  sizeBytes  Int
  sha256     String
  createdAt  DateTime            @default(now())
  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaign   Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([campaignId])
}

model Campaign {
  id                String            @id @default(uuid())
  advertiserId      String
  // Hashtag creators must use, e.g. VZ4821.
  code              String            @unique
  title             String
  objective         CampaignObjective
  countries         String[]
  cities            String[]
  startsAt          DateTime
  endsAt            DateTime
  package           CampaignPackage
  // Total budget in FCFA (XOF).
  budget            Int
  contentCase       ContentCase
  // Extra links (a shared folder, for instance); the files are in CampaignFile.
  assetUrls         String[]
  // Who creates the content when the advertiser brings nothing.
  noAssetsChoice    NoAssetsChoice?
  // The brief: what the post must say and make people do.
  keyMessage        String?
  callToAction      String?
  caption           String?
  // Sound or music to use, by name or link.
  sound             String?
  productDetails    String?
  shipsProduct      Boolean           @default(false)
  productPickup     String?
  faceRequired      Boolean           @default(false)
  language          String
  minDurationSec    Int?
  maxDurationSec    Int?
  tone              String?
  mandatoryElements String[]
  forbiddenElements String[]
  examples          String[]
  status            CampaignStatus    @default(PENDING_PAYMENT)
  statusReason      String?
  // Set once the budget is held in escrow; tasks are only shown after that.
  fundedAt          DateTime?
  // Part of the escrow already paid out for validated views, in FCFA.
  spent             Int               @default(0)
  // Closed by the system: what was left in escrow went back to the advertiser.
  completedAt       DateTime?
  // Escrow given back after the closing, in FCFA; spent keeps what was paid.
  refunded          Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  advertiser        User              @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  tasks             CampaignTask[]
  reviews           CampaignReview[]
  files             CampaignFile[]

  @@index([status, createdAt])
  @@index([advertiserId, createdAt])
}

// One task per platform of a campaign; creators accept it and post on that network.
model CampaignTask {
  id                 String           @id @default(uuid())
  campaignId         String
  network            SocialNetwork
  contentType        ContentType
  // Part of the campaign budget for this platform, in FCFA.
  budget             Int
  // Order in which the advertiser added the platform.
  position           Int
  // What the creator earns per 1,000 validated views, in FCFA.
  creatorRatePer1000 Int
  campaign           Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignments        TaskAssignment[]

  @@unique([campaignId, network])
}

enum AssignmentStatus {
  ACCEPTED
  SUBMITTED
}

// Where the team stands on a published post, separate from the creator's steps.
enum PostReviewStatus {
  TO_REVIEW // À vérifier
  VALIDATED // Validé
  NEEDS_FIX // À corriger, the creator sends a new proof
  REJECTED // Refusé, no payment
}

model TaskAssignment {
  id             String           @id @default(uuid())
  taskId         String
  creatorId      String
  status         AssignmentStatus @default(ACCEPTED)
  postUrl        String?
  acceptedAt     DateTime         @default(now())
  submittedAt    DateTime?
  validViews     Int              @default(0)
  earned         Int              @default(0)
  reviewStatus   PostReviewStatus @default(TO_REVIEW)
  reviewReason   String?
  reviewedAt     DateTime?
  // 0 to 100, recomputed whenever a proof or a view count comes in.
  riskScore      Int              @default(0)
  // WhatsApp Statut reminders already sent (12 h, 23 h).
  remindersSent  Int              @default(0)
  // Last automatic view count, for posts the platform can be asked about.
  viewsFetchedAt DateTime?
  task           CampaignTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creator        User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  proofs         PostProof[]
  snapshots      ViewSnapshot[]
  reviews        PostReview[]

  @@unique([taskId, creatorId])
  @@index([creatorId, acceptedAt])
  @@index([status, reviewStatus, riskScore])
}

enum ProofKind {
  SCREENSHOT
  LINK
}

// Evidence a creator sends for a post: a screenshot (stored on disk) or a link.
model PostProof {
  id            String         @id @default(uuid())
  assignmentId  String
  kind          ProofKind
  url           String?
  fileKey       String?
  mimeType      String?
  sizeBytes     Int?
  sha256        String?
  // When the creator says the screenshot was taken (file date on the phone).
  capturedAt    DateTime?
  declaredViews Int?
  deviceId      String?
  ip            String?
  uploadedAt    DateTime       @default(now())
  assignment    TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, uploadedAt])
  @@index([sha256])
  @@index([deviceId])
}

enum ViewSource {
  CREATOR // declared with a proof
  STAFF // entered by the team
  API // read from the platform
}

// One reading of a post's views at a point in time: the views history.
model ViewSnapshot {
  id           String         @id @default(uuid())
  assignmentId String
  views        Int
  source       ViewSource
  proofId      String?
  recordedById String?
  takenAt      DateTime       @default(now())
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, takenAt])
}

enum PostReviewAction {
  VIEWS // validated views entered
  VALIDATE
  NEEDS_FIX
  REJECT
  SUSPEND_ACCOUNT
}

// Audit trail: who did what on a post, and why.
model PostReview {
  id           String           @id @default(uuid())
  assignmentId String
  reviewerId   String
  action       PostReviewAction
  views        Int?
  reason       String?
  createdAt    DateTime         @default(now())
  assignment   TaskAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
}

model CampaignReview {
  id         String         @id @default(uuid())
  campaignId String
  reviewerId String
  status     CampaignStatus
  reason     String?
  createdAt  DateTime       @default(now())
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

enum TransactionType {
  DEPOSIT
  ESCROW
  EARNING
  COMMISSION
  WITHDRAWAL
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Wallet ledger: credits are positive, debits negative. The balance is the sum
// of completed entries already available, minus pending withdrawals.
model Transaction {
  id           String            @id @default(uuid())
  userId       String
  type         TransactionType
  amount       Int
  currency     String            @default("XOF")
  status       TransactionStatus @default(COMPLETED)
  // Earnings are held until this date (security hold, see specification).
  availableAt  DateTime          @default(now())
  campaignId   String?
  assignmentId String?
  paymentId    String?           @unique
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment      Payment?          @relation(fields: [paymentId], references: [id])

  @@index([userId, createdAt])
  @@index([campaignId])
}

enum PaymentKind {
  PAYIN
  PAYOUT
}

enum PaymentStatus {
  // Withdrawal waiting for the finance team.
  REQUESTED
  // Sent to the provider, waiting for its result.
  PROCESSING
  SUCCEEDED
  FAILED
  // Withdrawal refused by the finance team.
  REJECTED
}

// A Mobile Money or card operation with a payment provider.
model Payment {
  id                String        @id @default(uuid())
  userId            String
  kind              PaymentKind
  // fedapay, cinetpay, flutterwave or local.
  provider          String
  // Our own reference, sent to the provider.
  reference         String        @unique
  providerRef       String?
  amount            Int
  currency          String        @default("XOF")
  phone             String
  beneficiaryName   String?
  operator          String?
  // Campaign funded by this payment, if any.
  campaignId        String?
  checkoutUrl       String?
  status            PaymentStatus
  failureReason     String?
  reviewedById      String?
  // Large withdrawals need a second finance approval by someone else.
  firstApprovedById String?
  firstApprovedAt   DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction       Transaction?

  @@unique([provider, providerRef])
  @@index([kind, status, createdAt])
  @@index([userId, createdAt])
}

enum NotificationType {
  NEW_TASK
  PROOF_REMINDER
  POST_VALIDATED
  POST_NEEDS_FIX
  POST_REJECTED
  ACCOUNT_REVIEWED
  CAMPAIGN_REVIEWED
  WITHDRAWAL_UPDATED
  IDENTITY_REVIEWED
  CAMPAIGN_COMPLETED
}

// In-app messages, shown in the bell on the web and in the app.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  // Path inside the web or app the notification leads to.
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A creator's login on a platform, so Viewzo can read their posts' views.
// Tokens are stored encrypted.
model SocialConnection {
  id               String        @id @default(uuid())
  userId           String
  network          SocialNetwork
  // The platform's id for the account (open_id, user id, page id).
  externalId       String?
  handle           String?
  accessToken      String
  refreshToken     String?
  expiresAt        DateTime?
  refreshExpiresAt DateTime?
  // Facebook: the page tokens, one per page the creator manages (JSON, encrypted).
  extra            String?
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network])
}

// Optional parts of Viewzo a super admin switches on in the back-office.
// A module without a row, or switched off, is hidden everywhere.
model PlatformModule {
  // See src/modules/modules.ts for the known keys.
  key       String   @id
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Vente en live TikTok (module LIVE_SALES) --------------------------------

// A product a seller offers during their TikTok lives.
model LiveProduct {
  id        String   @id @default(uuid())
  sellerId  String
  name      String
  // FCFA (XOF).
  price     Int
  // Null: no stock limit.
  stock     Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
}

enum LiveSaleStatus {
  SCHEDULED
  RUNNING
  ENDED
  CANCELLED
}

// One TikTok live a seller sells in. Comments are read while it runs.
model LiveSale {
  id             String         @id @default(uuid())
  sellerId       String
  title          String
  // TikTok username the comments are read from, without @.
  tiktokUsername String
  scheduledAt    DateTime
  // Simulated comments instead of TikTok, to try the module.
  demo           Boolean        @default(false)
  // Products of the day; empty means every active product of the seller.
  productIds     String[]       @default([])
  status         LiveSaleStatus @default(SCHEDULED)
  startedAt      DateTime?
  endedAt        DateTime?
  viewers        Int?
  // Last message of the TikTok connection (connected, disconnected, error).
  sourceState    String?
  sourceMessage  String?
  // Set by the team when it stops a live; the seller sees the reason.
  cancelReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  seller         User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  leads          LiveLead[]
  comments       LiveComment[]

  @@index([sellerId, scheduledAt])
  @@index([status, scheduledAt])
}

enum LiveLeadStatus {
  NEW
  CONTACTED
  PAID
  DELIVERED
  CANCELLED
}

// One interested customer per live and TikTok user, with their cart and the
// code they send on WhatsApp.
model LiveLead {
  id         String         @id @default(uuid())
  liveId     String
  // VZ + 4 characters, unique so a shared WhatsApp number finds the order.
  code       String         @unique
  tiktokUser String
  nickname   String
  // achat, question_prix, question_produit, question_livraison, annulation.
  intent     String
  // [{ productId, name, variant, quantity, unitPrice }]
  items      Json           @default("[]")
  // Sum of the priced lines, FCFA; null when no line has a price.
  total      Int?
  // Answer the seller can read out in the live.
  reply      String?
  status     LiveLeadStatus @default(NEW)
  // A phone number was written in a comment (masked, never stored).
  phoneSeen  Boolean        @default(false)
  firstAt    DateTime       @default(now())
  lastAt     DateTime       @default(now())
  live       LiveSale       @relation(fields: [liveId], references: [id], onDelete: Cascade)
  comments   LiveComment[]

  @@unique([liveId, tiktokUser])
  @@index([liveId, lastAt])
}

// A comment read from the live, kept for the live screen and the summary.
model LiveComment {
  id         String    @id @default(uuid())
  liveId     String
  leadId     String?
  // TikTok message id, so a comment read twice is stored once.
  externalId String
  tiktokUser String
  nickname   String
  // Phone numbers are masked before saving.
  text       String
  intent     String?
  // "IA" or "mots-clés".
  by         String?
  at         DateTime
  live       LiveSale  @relation(fields: [liveId], references: [id], onDelete: Cascade)
  lead       LiveLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([liveId, externalId])
  @@index([liveId, at])
}
