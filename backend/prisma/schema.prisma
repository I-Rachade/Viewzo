generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  // Viewzo team member with access to the back-office endpoints.
  STAFF
}

enum ProfileType {
  CREATOR
  ADVERTISER
  PROVIDER
}

model User {
  id           String           @id @default(uuid())
  phone        String           @unique
  // ISO 3166-1 alpha-2 country derived from the phone number.
  country      String
  // Signup position within the country, timestamped and never changed afterwards.
  priorityRank Int
  locale       String           @default("fr")
  role         UserRole         @default(USER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  profiles     UserProfile[]
  accounts     SocialAccount[]
  skills       CreatorSkills?
  campaigns    Campaign[]
  assignments  TaskAssignment[]

  @@unique([country, priorityRank])
}

model UserProfile {
  id        String      @id @default(uuid())
  userId    String
  type      ProfileType
  // Verification level 1-3 as defined in the specification.
  level     Int         @default(1)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model CountryCounter {
  country  String @id
  lastRank Int    @default(0)
}

model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

enum SocialNetwork {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  SNAPCHAT
  X
  LINKEDIN
  THREADS
  TELEGRAM
  WHATSAPP_STATUS
}

// Statuses shown in "Mes comptes".
enum AccountStatus {
  PENDING // En vérification
  ELIGIBLE // Éligible
  NEEDS_FIX // À corriger
  NOT_ELIGIBLE // Non éligible, new attempt after retryAfter
  SUSPENDED // Suspendu (fraude ou plainte)
}

// A creator's account on one network, verified before tasks are offered on it.
model SocialAccount {
  id               String          @id @default(uuid())
  userId           String
  network          SocialNetwork
  // Handle or profile link; for WhatsApp Statut the phone number used.
  handle           String
  // Unique code placed in the bio, or sent by WhatsApp to the verification number.
  verificationCode String          @unique
  status           AccountStatus   @default(PENDING)
  // What the creator must fix, or why the account is not eligible or suspended.
  statusReason     String?
  retryAfter       DateTime?
  // Last time the account was (re)sent to verification; review is due within 48 h.
  submittedAt      DateTime        @default(now())
  followers        Int?
  // WhatsApp Statut only: average viewers per status.
  avgStatusViews   Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews          AccountReview[]

  @@unique([userId, network])
}

// Every verification decision and its reason, kept for audit even after the
// creator removes the account.
model AccountReview {
  id         String         @id @default(uuid())
  accountId  String?
  userId     String
  network    SocialNetwork
  // Null when the decision was made automatically.
  reviewerId String?
  status     AccountStatus
  reason     String?
  createdAt  DateTime       @default(now())
  account    SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
}

enum CreatorTaskType {
  POST_PROVIDED_VISUAL
  POST_PROVIDED_VIDEO
  CREATE_ORIGINAL_VIDEO
}

enum CreatorSpecialty {
  FACECAM
  VLOG
  PRODUCT_DEMO
  UNBOXING
  TUTORIAL
  DANCE_CHALLENGE
  HUMOR_SKETCH
  STREET_INTERVIEW
  FULL_EDITING
  MOTION_DESIGN
  VOICE_OVER
  PRODUCT_PHOTO
}

// Answers to the creator skills form.
model CreatorSkills {
  userId          String             @id
  taskTypes       CreatorTaskType[]
  specialties     CreatorSpecialty[]
  showsFace       Boolean
  phoneModel      String?
  microphone      String?
  lighting        String?
  editingSoftware String?
  // 3 to 5 links to videos made by the creator.
  exampleLinks    String[]
  languages       String[]
  // Countries (ISO codes) and cities where the creator can shoot.
  countries       String[]
  cities          String[]
  themes          String[]
  tasksPerWeek    Int
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CampaignObjective {
  AWARENESS
  SALES
  DOWNLOADS
  TRAFFIC
}

// Fixes how many platforms a campaign may use: Basique 1, Pro 3, Premium 6, Élite all.
enum CampaignPackage {
  BASIC
  PRO
  PREMIUM
  ELITE
}

// Without provided assets: videos made by the creators, or designed by the Studio.
enum NoAssetsChoice {
  CREATOR_VIDEOS
  STUDIO
}

enum ContentType {
  PROVIDED_ASSETS // Publication des éléments fournis
  VIDEO_WITH_POSTERS // Vidéo avec les affiches fournies
  FACECAM
  VLOG_DEMO_UNBOXING
  FULL_EDITING
  MOTION_DESIGN
  FREE_BRIEF // Libre selon brief
}

enum CampaignStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  COMPLETED
}

model Campaign {
  id                String            @id @default(uuid())
  advertiserId      String
  // Hashtag creators must use, e.g. VZ4821.
  code              String            @unique
  title             String
  objective         CampaignObjective
  countries         String[]
  cities            String[]
  startsAt          DateTime
  endsAt            DateTime
  package           CampaignPackage
  // Total budget in FCFA (XOF).
  budget            Int
  hasAssets         Boolean
  // Links to the provided posters, videos, logos (file upload comes with storage).
  assetUrls         String[]
  noAssetsChoice    NoAssetsChoice?
  shipsProduct      Boolean           @default(false)
  productPickup     String?
  faceRequired      Boolean           @default(false)
  language          String
  minDurationSec    Int?
  maxDurationSec    Int?
  tone              String?
  mandatoryElements String[]
  forbiddenElements String[]
  examples          String[]
  status            CampaignStatus    @default(PENDING_REVIEW)
  statusReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  advertiser        User              @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  tasks             CampaignTask[]
  reviews           CampaignReview[]

  @@index([status, createdAt])
  @@index([advertiserId, createdAt])
}

// One task per platform of a campaign; creators accept it and post on that network.
model CampaignTask {
  id                 String           @id @default(uuid())
  campaignId         String
  network            SocialNetwork
  contentType        ContentType
  // Part of the campaign budget for this platform, in FCFA.
  budget             Int
  // Order in which the advertiser added the platform.
  position           Int
  // What the creator earns per 1,000 validated views, in FCFA.
  creatorRatePer1000 Int
  campaign           Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignments        TaskAssignment[]

  @@unique([campaignId, network])
}

enum AssignmentStatus {
  ACCEPTED
  SUBMITTED
}

model TaskAssignment {
  id          String           @id @default(uuid())
  taskId      String
  creatorId   String
  status      AssignmentStatus @default(ACCEPTED)
  postUrl     String?
  acceptedAt  DateTime         @default(now())
  submittedAt DateTime?
  task        CampaignTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creator     User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([taskId, creatorId])
  @@index([creatorId, acceptedAt])
}

// Every moderation decision on a campaign, kept for audit.
model CampaignReview {
  id         String         @id @default(uuid())
  campaignId String
  reviewerId String
  status     CampaignStatus
  reason     String?
  createdAt  DateTime       @default(now())
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}
