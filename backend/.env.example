DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viewzo
JWT_SECRET=change-me
OTP_SECRET=change-me-too
# local: codes are printed in the backend log. didit: codes are sent via Didit.
OTP_PROVIDER=local
DIDIT_API_KEY=
# Empty: email codes are printed in the backend log. cloudflare: sent via Cloudflare Email Sending.
MAIL_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
MAIL_FROM=noreply@viewzo.app
# Ranks up to this number get the founder badge.
FOUNDER_BADGE_LIMIT=1000
# Default region used to parse numbers written without +country prefix.
DEFAULT_REGION=TG
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Official WhatsApp numbers creators message to verify WhatsApp Statut, per country.
WHATSAPP_VERIFICATION_NUMBERS=TG:+22890000000,BJ:+22990000000
# local: every payment succeeds at once (development only). Unset in production.
PAYMENT_MODE=local
# Public API URL the payment providers send their notifications to.
API_PUBLIC_URL=http://localhost:3001
# Provider per country, "*" for all others. Default:
# TG,BJ → fedapay; CI,SN,CM,BF,ML,NE,GN,CD → cinetpay; others → flutterwave.
PAYMENT_ROUTES=
MIN_WITHDRAWAL=1000
FEDAPAY_SECRET_KEY=
# sandbox or live
FEDAPAY_ENV=sandbox
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_TRANSFER_PASSWORD=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Screenshots sent as proof (a Docker volume in production).
UPLOAD_DIR=./uploads
# Encrypts the creators' platform tokens; defaults to JWT_SECRET.
TOKEN_ENCRYPTION_KEY=
# Automatic view counts. Empty: that platform's views come from screenshots.
YOUTUBE_API_KEY=
# X API plan with read access (public_metrics.impression_count).
X_BEARER_TOKEN=
# Platform apps creators connect their account to (OAuth). Callback URL to
# register on each platform: API_PUBLIC_URL/connections/<network>/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# 1 turns off reminders and automatic view counts (background jobs).
JOBS_DISABLED=
