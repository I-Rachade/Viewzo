DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viewzo
JWT_SECRET=change-me
OTP_SECRET=change-me-too
# local: codes are printed in the backend log. didit: codes are sent via Didit.
OTP_PROVIDER=local
DIDIT_API_KEY=
# Ranks up to this number get the founder badge.
FOUNDER_BADGE_LIMIT=1000
# Default region used to parse numbers written without +country prefix.
DEFAULT_REGION=TG
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Official WhatsApp numbers creators message to verify WhatsApp Statut, per country.
WHATSAPP_VERIFICATION_NUMBERS=TG:+22890000000,BJ:+22990000000
# local: every payment succeeds at once (development only). Unset in production.
PAYMENT_MODE=local
# Public API URL the payment providers send their notifications to.
API_PUBLIC_URL=http://localhost:3001
# Provider per country, "*" for all others. Default:
# TG,BJ → fedapay; CI,SN,CM,BF,ML,NE,GN,CD → cinetpay; others → flutterwave.
PAYMENT_ROUTES=
MIN_WITHDRAWAL=1000
FEDAPAY_SECRET_KEY=
# sandbox or live
FEDAPAY_ENV=sandbox
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_TRANSFER_PASSWORD=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
