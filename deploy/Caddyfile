# The visitor's address comes from CF-Connecting-IP, but only when the request
# really arrives from Cloudflare (ranges from https://www.cloudflare.com/ips/).
# Anything else keeps the connecting address, so a forged header is ignored.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Cloudflare sits in front (proxied DNS, SSL mode "Full (strict)") and talks to
# Caddy over HTTPS with a Cloudflare Origin Certificate stored in ./certs.
(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	import origin_tls
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	import origin_tls
	header X-Frame-Options DENY
	# Overwrites whatever the client sent; the API trusts only this header.
	reverse_proxy api:3001 {
		header_up X-Viewzo-Client-Ip {client_ip}
	}
}
