# Copy to /opt/viewzo/.env on the server and fill in. Never commit the real file.

# Domain served through Cloudflare (web on DOMAIN, API on api.DOMAIN).
DOMAIN=viewzo.app

# GitHub owner of the container images, lowercase.
GHCR_OWNER=i-rachade
IMAGE_TAG=latest

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
OTP_SECRET=

# SMS login codes via Didit.
OTP_PROVIDER=didit
DIDIT_API_KEY=

# Identity check for level 2 (ID photos and selfie) uses the same
# DIDIT_API_KEY. Empty key: verification stays closed and nobody reaches level 2.

# Registration codes by email via Cloudflare Email Sending (Workers Paid plan,
# viewzo.app added as sending domain). Leave MAIL_PROVIDER empty to log mails instead.
MAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
MAIL_FROM=noreply@viewzo.app

FOUNDER_BADGE_LIMIT=1000
DEFAULT_REGION=TG
WHATSAPP_VERIFICATION_NUMBERS=TG:+22890000000,BJ:+22990000000

# Mobile Money. Each provider stays off until its keys are set.
# Webhook URLs to enter in each dashboard: https://api.DOMAIN/payments/webhooks/fedapay
# (…/cinetpay, …/flutterwave).
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=live
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_TRANSFER_PASSWORD=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Automatic view counts (empty: views come from screenshots) ---
YOUTUBE_API_KEY=
# X API plan with read access.
X_BEARER_TOKEN=
# Apps creators connect their account to. Callback URL on each platform:
# https://api.<DOMAIN>/connections/<tiktok|instagram|facebook|threads>/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- Vente en live TikTok (module switched on in Back-office -> Modules) ---
# Claude reads the live comments (console.anthropic.com -> API Keys).
# Empty: keyword rules instead.
ANTHROPIC_API_KEY=
LIVE_AI_MODEL=claude-opus-5-5
# Optional Euler Stream key that signs the TikTok live connection.
EULER_API_KEY=
# Encrypts the creators' platform tokens. Required: at least 32 characters
# and different from JWT_SECRET (openssl rand -hex 32). When you change it,
# put the old value in TOKEN_ENCRYPTION_KEY_PREVIOUS (comma-separated) so
# connected accounts keep working.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Optional: provider per country, e.g. TG:fedapay,CI:cinetpay,*:flutterwave
PAYMENT_ROUTES=
MIN_WITHDRAWAL=1000
# Withdrawals from this amount (FCFA) need two different finance members.
PAYOUT_SECOND_APPROVAL_FROM=100000
# Test mode only: local makes every payment succeed at once, without any
# provider and without real money. Anyone could top up for free, so leave it
# empty as soon as real users sign up. The API refuses to start with it in
# production unless ALLOW_TEST_PAYMENTS=yes is set as well.
PAYMENT_MODE=
ALLOW_TEST_PAYMENTS=

# Cloudflare R2 for daily database backups.
R2_ACCOUNT_ID=
R2_BUCKET=viewzo-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cron schedule in UTC.
BACKUP_CRON=0 3 * * *
